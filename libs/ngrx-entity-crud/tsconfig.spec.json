{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "module": "preserve",
    "lib": ["dom", "es2022"],
    "isolatedModules": true,
    "emitDecoratorMetadata": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.spec.ts", "**/*.d.ts"],
  "exclude": ["schematics/*/files/**/*"]
}
