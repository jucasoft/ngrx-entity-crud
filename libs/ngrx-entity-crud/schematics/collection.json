{
  "$schema": "../../../node_modules/@angular-devkit/schematics/collection-schema.json",
  "schematics": {
    "store": {
      "description": "add store",
      "factory": "./store/index#makeStore",
      "schema": "./store/schema.json"
    },
    "section": {
      "description": "add section",
      "factory": "./section/index#crudSection",
      "schema": "./section/schema.json"
    },
    "auth": {
      "description": "add login integration",
      "factory": "./auth/index#makeAuth",
      "schema": "./auth/schema.json"
    },
    "ng-add": {
      "description": "Add my library to the project.",
      "factory": "./ng-add/index#ngAdd",
      "schema": "./ng-add/schema.json"
    },
    "lazy-report": {
      "description": "Scan the project and report which stores are lazy candidates.",
      "factory": "./lazy-report/index#lazyReport",
      "schema": "./lazy-report/schema.json"
    },
    "table-report": {
      "description": "Scan the project and report every data table (ag-Grid / p-table) and its configuration.",
      "factory": "./table-report/index#tableReport",
      "schema": "./table-report/schema.json"
    },
    "dashboard": {
      "description": "Scaffold a project dashboard view (storage + lazy diagnostics) hosting <nec-dashboard>.",
      "factory": "./dashboard/index#makeDashboard",
      "schema": "./dashboard/schema.json"
    }
  }
}
