# graphify: aggiorna il knowledge graph dopo il commit (solo codice/AST, non blocca mai).
# Le modifiche ai documenti richiedono comunque `/graphify --update`.
if command -v graphify >/dev/null 2>&1; then
  if graphify update . --force >/dev/null 2>&1; then
    echo "[graphify] knowledge graph aggiornato -> graphify-out/graph.json"
  else
    echo "[graphify] aggiornamento fallito (lancia 'graphify update . --force' per i dettagli)"
  fi
fi

exit 0
