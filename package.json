{
  "name": "ngrx-entity-crud",
  "version": "0.0.0",
  "private": true,
  "repository": "https://github.com/jucasoft/ngrx-entity-crud",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build ngrx-entity-crud --skip-nx-cache && npm run build:schematics && npm run check:compat",
    "testLibs": "nx test ngrx-entity-crud",
    "test": "nx test",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "nx e2e",
    "build:schematics": "nx run ngrx-entity-crud:build-schematics",
    "build:schematics:watch": "nx run ngrx-entity-crud:build-schematics:watch",
    "check:compat": "node scripts/check-compat.js",
    "link": "nx run ngrx-entity-crud:link",
    "link:copy": "npm run build && node scripts/link-copy.js",
    "link:copy-only": "node scripts/link-copy.js",
    "dev": "nx build ngrx-entity-crud --watch",
    "publish": "nx run ngrx-entity-crud:publish",
    "publish:beta": "nx run ngrx-entity-crud:publish-beta",
    "npm:build:watch": "nx build ngrx-entity-crud --watch",
    "npm:build:link": "nx run ngrx-entity-crud:link",
    "npm:publish": "nx run ngrx-entity-crud:publish",
    "npm:build:publish": "nx run ngrx-entity-crud:publish",
    "npm:build:publish:beta": "nx run ngrx-entity-crud:publish-beta",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngrx/component": "^22.0.1",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular-devkit/core": "^22.2.5",
    "@angular-devkit/schematics": "^22.2.5",
    "@angular-devkit/schematics-cli": "^22.2.5",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/animations": "^22.2.3",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/jest": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/workspace": "24.0.2",
    "@schematics/angular": "^22.2.5",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.20",
    "@swc/helpers": "~0.5.23",
    "@types/jest": "^30.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.5",
    "nx": "24.0.2",
    "postcss": "^8.4.5",
    "postcss-url": "~10.1.3",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
