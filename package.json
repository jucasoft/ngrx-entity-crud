{
  "name": "ngrx-entity-crud",
  "version": "13.1.0",
  "repository": "https://github.com/jucasoft/ngrx-entity-crud",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ngrx-entity-crud && npm run build:schematics",
    "testLibs": "ng test ngrx-entity-crud",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build:schematics": "tsc -p ./projects/ngrx-entity-crud/tsconfig.schematics.json",
    "npm:build:link": "npm run build && cd libs/ngrx-entity-crud/ && npm link",
    "npm:publish": "cd libs/ngrx-entity-crud/ && npm publish",
    "npm:build:publish": "npm run build && npm run npm:publish",
    "npm:build:publish:beta": "npm run build && cd libs/ngrx-entity-crud/ && npm publish --tag beta"
  },
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ngrx/component": "^19.2.1",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/entity": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngrx/store-devtools": "^19.2.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^19.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular-devkit/core": "^19.2.15",
    "@angular-devkit/schematics": "^19.2.15",
    "@angular-devkit/schematics-cli": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.2",
    "typescript": "~5.7.2"
  }
}
