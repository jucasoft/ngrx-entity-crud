    "@angular/compiler-cli": "^19.2.15",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "21.5.2",
    "@nx/eslint": "21.5.2",
    "@nx/eslint-plugin": "21.5.2",
    "@nx/jest": "21.5.2",
    "@nx/js": "21.5.2",
    "@nx/workspace": "21.5.2",
    "@schematics/angular": "^19.2.15",
